<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HWID Checker" Width="1096" Height="972" MinWidth="876" MinHeight="616"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="SF Pro Text, Inter, Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextRenderingMode="Grayscale" Foreground="{DynamicResource Text}">
  <Window.Resources>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle RadiusX="10" RadiusY="10" Margin="-2" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" Opacity=".55"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Boutons de fenetre -->
    <Style x:Key="Light" TargetType="Button">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Stroke="#22000000" StrokeThickness=".5"/>
              <Path x:Name="glyph" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="#99000000"
                    StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="14" Height="14" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                <Setter TargetName="glyph" Property="Opacity" Value="1"/>
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource LightOff}"/>
              </MultiDataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="dot" Property="Opacity" Value=".7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton icone pose sur une pastille de verre -->
    <Style x:Key="GlassIcon" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="15">
              <Viewbox x:Name="v" Width="18" Height="18" RenderTransformOrigin=".5,.5">
                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="24" Height="24"
                      Stroke="{DynamicResource Text}" StrokeThickness="1.9" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="v" Property="Opacity" Value=".5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="v" Property="Opacity" Value=".3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton capsule -->
    <Style x:Key="Capsule" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="15,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Control}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="15"/>
              <Border x:Name="h" Background="{DynamicResource Hover}" CornerRadius="15" Opacity="0"/>
              <ContentPresenter x:Name="c" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="h" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="c" Property="Opacity" Value=".6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CapsuleAccent" TargetType="Button" BasedOn="{StaticResource Capsule}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Element de la barre laterale -->
    <Style x:Key="SideItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="side"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="8,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Selection}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Controle segmente -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="13" Padding="14,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interrupteur -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="48" Height="24" Background="Transparent">
              <Border x:Name="track" CornerRadius="12" Background="{DynamicResource SwitchOff}"/>
              <Border x:Name="on" CornerRadius="12" Background="{DynamicResource Accent}" Opacity="0"/>
              <Border CornerRadius="10" Width="28" Height="20" Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Border.RenderTransform><TranslateTransform x:Name="t"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="t" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="t" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Curseur -->
    <Style x:Key="SlideBtn" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"><Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SlideBtn}" Command="Slider.DecreaseLarge" Background="{DynamicResource Accent}" Margin="0,0,-6,0"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SlideBtn}" Command="Slider.IncreaseLarge" Background="{DynamicResource SwitchOff}" Margin="-6,0,0,0"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Panel.ZIndex="2" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Width="28" Height="18" CornerRadius="9" Background="White">
                          <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Direction="270"/></Border.Effect>
                        </Border>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barre de defilement superposee -->
    <Style x:Key="NoBtn" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="13"/>
      <Setter Property="MinWidth" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource NoBtn}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource NoBtn}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Border x:Name="b" Width="6" CornerRadius="3" Background="{DynamicResource Scroll}" HorizontalAlignment="Center"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Width" Value="8"/><Setter TargetName="b" Property="CornerRadius" Value="4"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <ScrollContentPresenter OpacityMask="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,64,1,12"
                         Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bulle d'aide -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Tip}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="11" Padding="12,8" MaxWidth="310" TextBlock.Foreground="{DynamicResource Text}" TextBlock.FontSize="12">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Champ de recherche -->
    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border CornerRadius="16" Background="{DynamicResource Field}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"/>
              <Border x:Name="ring" CornerRadius="18" Margin="-2" BorderBrush="{DynamicResource Accent}" BorderThickness="2.5" Opacity="0"/>
              <Viewbox Width="15" Height="15" HorizontalAlignment="Left" Margin="11,0,0,0">
                <Path Data="M10.5 4 A6.5 6.5 0 1 1 10.5 17 A6.5 6.5 0 1 1 10.5 4 Z M15.5 15.5 L20.5 20.5" Width="24" Height="24"
                      Stroke="{DynamicResource Text2}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Viewbox>
              <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Text2}" Margin="33,0,0,1" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="31,0,12,1" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Opacity" Value=".55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ligne de formulaire cliquable -->
    <Style x:Key="Row" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="10,0" Margin="4,0" MinHeight="40">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Outer" RenderTransformOrigin=".5,.5">
    <!-- Ombre : element separe pour ne pas flouter le texte -->
    <Border x:Name="Shadow" Margin="28" CornerRadius="20" Background="#FF202020">
      <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity=".42"/></Border.Effect>
    </Border>

    <Grid x:Name="Shell" Margin="28">
      <Rectangle x:Name="Wall" Fill="#3A4660"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <!-- Barre laterale bord a bord -->
        <Border Background="{DynamicResource SidebarTint}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="4" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource Sep}"/>
            <Grid x:Name="SideDrag" Background="Transparent">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Background="Transparent">
                <Button x:Name="BtnClose" Style="{StaticResource Light}" Background="#FF5F57" Tag="M4.8 4.8 L9.2 9.2 M9.2 4.8 L4.8 9.2" AutomationProperties.Name="Fermer"/>
                <Button x:Name="BtnMin" Style="{StaticResource Light}" Background="#FEBC2E" Tag="M4 7 L10 7" AutomationProperties.Name="Réduire"/>
                <Button x:Name="BtnMax" Style="{StaticResource Light}" Background="#28C840" Tag="M4 7 L10 7 M7 4 L7 10" AutomationProperties.Name="Agrandir"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource Search}" Margin="12,0,12,12" AutomationProperties.Name="Rechercher"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
              <StackPanel x:Name="Side" Margin="12,0,12,12" KeyboardNavigation.DirectionalNavigation="Contained"/>
            </ScrollViewer>
            <Button x:Name="BtnCredit" Grid.Row="3" Style="{StaticResource Row}" Margin="8,0,8,10">
              <TextBlock FontSize="11.5" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center">
                <Run Text="Made by"/><Run Text=" "/><Run Text="1skf" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><Run Text=" "/><Run Text="· Discord"/>
              </TextBlock>
            </Button>
          </Grid>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1">
          <Rectangle Fill="{DynamicResource ContentTint}"/>
          <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Tag>
              <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,76">
                <GradientStop Offset=".28" Color="#00000000"/>
                <GradientStop Offset=".6" Color="#1C000000"/>
                <GradientStop Offset="1" Color="#FF000000"/>
              </LinearGradientBrush>
            </ScrollViewer.Tag>
            <Grid x:Name="PageHost" Margin="0"/>
          </ScrollViewer>

          <!-- Barre d'outils -->
          <Grid x:Name="Toolbar" Height="60" VerticalAlignment="Top" Background="Transparent">
            <TextBlock x:Name="PageTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="26,0,320,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
              <Grid x:Name="Pill1" Margin="0,0,8,0">
                <Border CornerRadius="18" Background="{DynamicResource GlassBase}">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity=".16"/></Border.Effect>
                </Border>
                <Grid x:Name="Lens1" IsHitTestVisible="False"/>
                <Border CornerRadius="18" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Margin="3">
                  <Button x:Name="BtnLang" Style="{StaticResource GlassIcon}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="15">
                          <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                  <Button x:Name="BtnMask" Style="{StaticResource GlassIcon}"/>
                  <Button x:Name="BtnRefresh" Style="{StaticResource GlassIcon}"/>
                </StackPanel>
              </Grid>
              <Grid x:Name="Pill2">
                <Border CornerRadius="18" Background="{DynamicResource GlassBase}">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity=".16"/></Border.Effect>
                </Border>
                <Grid x:Name="Lens2" IsHitTestVisible="False"/>
                <Border CornerRadius="18" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Margin="3">
                  <Button x:Name="BtnCopy" Style="{StaticResource GlassIcon}"/>
                  <Button x:Name="BtnExport" Style="{StaticResource GlassIcon}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Notification -->
          <Grid x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Opacity="0" IsHitTestVisible="False">
            <Border CornerRadius="18" Background="{DynamicResource Tip}">
              <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity=".28"/></Border.Effect>
            </Border>
            <Border CornerRadius="18" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" Padding="18,0" Height="36">
              <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
            </Border>
          </Grid>
        </Grid>
      </Grid>
      <Border x:Name="Rim" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource WindowRim}" IsHitTestVisible="False"/>
    </Grid>
  </Grid>
</Window>
